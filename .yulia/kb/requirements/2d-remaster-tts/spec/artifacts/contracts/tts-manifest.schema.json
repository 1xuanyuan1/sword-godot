{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-remaster.invalid/schemas/tts-manifest.schema.json",
  "title": "Sword Remaster TTS Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chapter", "model", "audio_profile", "entries"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "chapter": { "const": 1 },
    "model": { "const": "speech-2.8-hd" },
    "audio_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_rate_hz", "bitrate_bps", "channels", "intermediate_format", "runtime_format"],
      "properties": {
        "sample_rate_hz": { "const": 32000 },
        "bitrate_bps": { "const": 128000 },
        "channels": { "const": 1 },
        "intermediate_format": { "const": "mp3" },
        "runtime_format": { "const": "ogg_vorbis_q5" }
      }
    },
    "pronunciation_dictionary_version": { "type": ["string", "null"] },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dialog_round_id",
        "message_ids",
        "speaker_id",
        "role",
        "text",
        "text_sha256",
        "voice_id",
        "voice_settings",
        "output_path",
        "audio_sha256",
        "review_status"
      ],
      "properties": {
        "dialog_round_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "message_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "speaker_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["dialogue", "narration"] },
        "text": { "type": "string", "minLength": 1 },
        "text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "voice_id": { "type": "string", "minLength": 1 },
        "voice_settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["speed", "pitch", "volume", "emotion"],
          "properties": {
            "speed": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
            "pitch": { "type": "integer", "minimum": -12, "maximum": 12 },
            "volume": { "type": "number", "minimum": 0.1, "maximum": 10.0 },
            "emotion": { "type": "string", "minLength": 1 }
          }
        },
        "output_path": {
          "type": "string",
          "pattern": "^tts/runtime/.+\\.ogg$"
        },
        "audio_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "review_status": { "enum": ["pending", "generated", "listened", "approved", "rejected"] },
        "notes": { "type": "string" }
      }
    }
  }
}
