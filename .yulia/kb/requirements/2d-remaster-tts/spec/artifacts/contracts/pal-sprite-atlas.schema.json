{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-remaster.invalid/schemas/pal-sprite-atlas.schema.json",
  "title": "PAL Remaster Sprite Atlas",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_sprite_number", "source_frame_count", "scale", "image", "image_sha256", "canvas_size", "frames"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "source_sprite_number": { "type": "integer", "minimum": 1 },
    "source_frame_count": { "type": "integer", "minimum": 1 },
    "scale": { "const": 5 },
    "image": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.png$" },
    "image_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canvas_size": { "$ref": "#/$defs/size" },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_frame_index", "rect", "pivot", "alpha_bounds", "duration_ms"],
        "properties": {
          "source_frame_index": { "type": "integer", "minimum": 0 },
          "rect": { "$ref": "#/$defs/rect" },
          "pivot": { "$ref": "#/$defs/point" },
          "alpha_bounds": { "$ref": "#/$defs/rect" },
          "duration_ms": { "type": "integer", "minimum": 1, "maximum": 5000 }
        }
      }
    }
  },
  "$defs": {
    "point": { "type": "array", "prefixItems": [{ "type": "integer" }, { "type": "integer" }], "minItems": 2, "maxItems": 2 },
    "size": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }], "minItems": 2, "maxItems": 2 },
    "rect": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }], "minItems": 4, "maxItems": 4 }
  }
}
