{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-godot.invalid/contracts/tts-manifest.schema.json",
  "title": "Sword Dialog TTS Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaults", "items"],
  "properties": {
    "version": { "const": 1 },
    "defaults": { "type": "object" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "chapter", "message_ids", "speaker_id", "text", "text_sha256", "output"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "chapter": { "type": "integer", "minimum": 1, "maximum": 18 },
          "message_ids": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true },
          "speaker_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1, "maxLength": 9999 },
          "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "output": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(ogg|mp3)$" },
          "audio_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
