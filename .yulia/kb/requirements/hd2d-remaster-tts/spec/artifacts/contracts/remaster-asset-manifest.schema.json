{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-godot.invalid/contracts/remaster-asset-manifest.schema.json",
  "title": "Remaster Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "version", "chapter", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "pack_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "version": { "type": "string", "minLength": 1 },
    "chapter": { "type": "integer", "minimum": 0, "maximum": 18 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_id", "type", "path", "sha256", "review_status", "source"],
      "properties": {
        "logical_id": { "type": "string", "pattern": "^(map|character|portrait|battlefield|battle|cutscene|voice|ui)/.+$" },
        "type": { "enum": ["environment", "field_sprite", "portrait", "battlefield", "battle_action", "cutscene", "voice", "ui_theme"] },
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "fallback_id": { "type": "string" },
        "review_status": { "enum": ["draft", "reviewed", "approved", "rejected", "retired"] },
        "source": {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["bitto", "procedural", "licensed", "manual"] },
            "model": { "type": "string" },
            "protocol": { "type": "string" },
            "prompt_version": { "type": "string" },
            "requested_size": { "type": "string" },
            "reference": { "type": "string" }
          }
        }
      }
    }
  }
}
