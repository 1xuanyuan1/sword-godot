{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-remaster.invalid/schemas/art-prompt-manifest.schema.json",
  "title": "Sword Remaster Art Prompt Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "style_guide_version", "prompts"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "style_guide_version": { "type": "string", "minLength": 1 },
    "prompts": {
      "type": "array",
      "items": { "$ref": "#/$defs/prompt" }
    }
  },
  "$defs": {
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset_id",
        "phase",
        "provider",
        "model",
        "prompt",
        "negative_prompt",
        "width",
        "height",
        "background",
        "source_references",
        "review_status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "asset_id": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["concept", "final"] },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "enum": ["nano-banana-2", "gpt-image-2"] },
        "prompt": { "type": "string", "minLength": 1 },
        "negative_prompt": { "type": "string" },
        "width": { "type": "integer", "minimum": 128 },
        "height": { "type": "integer", "minimum": 128 },
        "background": { "enum": ["opaque", "solid_key_color"] },
        "seed": { "type": ["integer", "null"] },
        "source_references": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "review_status": { "enum": ["draft", "generated", "approved", "rejected"] },
        "output_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "notes": { "type": "string" }
      }
    }
  }
}
